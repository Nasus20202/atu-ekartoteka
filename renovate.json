{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Own images are built by this owner's CI, so no release delay",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/nasus20202/**"],
      "minimumReleaseAge": "0 days"
    }
  ]
}
