{
  "name": "atu-ekartoteka",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev",
    "dev:pretty": "next dev | pino-pretty",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "mocks": "tsx e2e/mocks/main.ts",
    "format:check": "prettier --check .",
    "precommit": "lint-staged && vitest --run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test --project='chromium*' --project='visual-*'",
    "test:e2e:firefox": "pnpm build && playwright test --project='firefox*'",
    "test:e2e:webkit": "pnpm build && playwright test --project='webkit*'",
    "test:e2e:ui": "pnpm build && playwright test --project='chromium*' --project='visual-*' --ui",
    "test:e2e:headed": "pnpm build && playwright test --project='chromium*' --project='visual-*' --headed",
    "test:e2e:debug": "pnpm build && playwright test --project='chromium*' --project='visual-*' --debug",
    "test:e2e:visual": "pnpm build && playwright test --project='visual-*'",
    "test:e2e:visual:update": "pnpm test:e2e:visual --update-snapshots=all",
    "test:perf": "mkdir -p perf-results && k6 run perf/load-test.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "forwarded-parse": "2.2.0",
    "prisma": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@marsidev/react-turnstile": "1.6.3",
    "@napi-rs/canvas": "1.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-pino": "0.71.0",
    "@opentelemetry/instrumentation-runtime-node": "0.38.0",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@playwright/test": "1.65.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/extension-read-replicas": "0.5.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@react-pdf/renderer": "4.9.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bcrypt": "6.0.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "bcrypt": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.10",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "iconv-lite": "0.7.3",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "1.0.0-beta.0",
    "node-cron": "4.6.0",
    "nodemailer": "10.4.0",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-sql": "0.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.8",
    "recharts": "3.10.1",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,sql}": [
      "prettier --write"
    ]
  }
}
