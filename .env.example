# Database
DATABASE_URL="postgresql://atu_user:atu_password@localhost:5432/atu_ekartoteka?schema=public"

# Database Read Replicas (optional, comma-separated list)
# Enables automatic read query routing to replica databases for improved performance
# Example: DATABASE_REPLICA_URLS="postgresql://user:pass@replica1:5432/db,postgresql://user:pass@replica2:5432/db"
DATABASE_REPLICA_URLS=""

# Connection pool per database client (primary and each replica).
# Total connections = pool size x number of clients. Defaults: 10 and 5000 ms.
DATABASE_POOL_MAX="10"
DATABASE_POOL_CONNECTION_TIMEOUT_MS="5000"

# Auth.js
AUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-key-change-this-in-production"

# Node Environment
NODE_ENV="development"

# Email Configuration (SMTP)
# Defaults point at the local mock: start it with `docker compose up -d mocks` or `pnpm mocks`.
# Captured mail is listed at http://localhost:4010/inbox.
# For a real provider (AWS SES, Gmail, SendGrid, etc.), set SMTP_HOST, SMTP_PORT
# (465 with SMTP_SECURE="true", or 587 with SMTP_SECURE="false"), SMTP_USER and SMTP_PASS.
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="ATU Ekartoteka"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Application URL (for email links)
APP_URL="http://localhost:3000"

# Tracking Script (optional)
# Add your custom tracking/analytics script here (e.g., Plausible, Umami, Google Analytics)
# Example for Plausible:
# TRACKING_SCRIPT="var script=document.createElement('script');script.defer=true;script.dataset.domain='yourdomain.com';script.src='https://plausible.io/js/script.js';document.head.appendChild(script);"
# Example for Umami:
# TRACKING_SCRIPT="var script=document.createElement('script');script.defer=true;script.dataset.websiteId='your-website-id';script.src='https://analytics.umami.is/script.js';document.head.appendChild(script);"
TRACKING_SCRIPT=""

# Space-separated list of origins allowed for the tracking script (both loading scripts and making requests).
# Required when TRACKING_SCRIPT loads or connects to external domains.
# Example: TRACKING_ORIGINS="https://analytics.example.com"
TRACKING_ORIGINS=""

# Cloudflare Turnstile (Captcha) Keys
# Defaults are Cloudflare's test keys. The widget script still loads from Cloudflare,
# but verification goes to the local mock, which accepts the widget's dummy token.
# Site key 2x00000000000000000000AB makes the widget always fail, to try the failure path.
# For real keys, set both keys from the Cloudflare dashboard and remove TURNSTILE_VERIFY_URL.
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_VERIFY_URL="http://localhost:4010/turnstile/siteverify"

# Google OAuth Configuration
# Defaults point at the local OpenID mock, which asks for an email address at sign-in.
# For real Google sign-in, set the client ID and secret from Google Cloud Console
# (APIs & Services -> Credentials) and remove GOOGLE_ISSUER_URL.
GOOGLE_CLIENT_ID="mock-google-client-id"
GOOGLE_CLIENT_SECRET="mock-google-client-secret"
GOOGLE_ISSUER_URL="http://localhost:4010/google"

# OpenTelemetry Configuration (optional)
# Set OTEL_EXPORTER_ENDPOINT to enable tracing
# Example: OTEL_EXPORTER_ENDPOINT="http://localhost:4318"
OTEL_EXPORTER_ENDPOINT=""
# Service name for traces (defaults to "atu-ekartoteka")
OTEL_SERVICE_NAME="atu-ekartoteka"
