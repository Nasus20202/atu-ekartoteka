// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  CREDENTIALS
  GOOGLE
}

enum UserRole {
  ADMIN
  TENANT
}

enum AccountStatus {
  PENDING    // Waiting for approval
  APPROVED   // Approved by admin
  REJECTED   // Rejected
}

model HomeownersAssociation {
  id          String   @id @default(cuid())
  externalId  String   @unique  // ID from folder structure
  name        String              // defaults to externalId, can be changed by admin

  // Parsed from pow_czynsz.txt on notification import
  header      String?
  footer      String?

  // Data-as-of dates from .wmb files, updated on each import
  apartmentsDataDate     DateTime?
  chargesDataDate        DateTime?
  notificationsDataDate  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  apartments  Apartment[]
  
  @@index([externalId])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String?
  // COLLATE "pl_numeric" (set in migration, not tracked by Prisma)
  name           String?
  role           UserRole @default(TENANT)
  status         AccountStatus @default(PENDING)
  emailVerified       Boolean  @default(false)
  mustChangePassword  Boolean  @default(false)
  authMethod          AuthMethod? @default(CREDENTIALS)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationship with apartments (one-to-many: one user can own multiple apartments)
  apartments         Apartment[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([emailVerified])
}

model Apartment {
  id                  String   @id @default(cuid())
  externalOwnerId     String       // Owner ID from file (e.g. "W00164")
  externalApartmentId String       // Apartment ID from HOA system (e.g. "KLO11-KLO11-00000-00004M")
  // owner, address, building, number: COLLATE "pl_numeric" (set in migration, not tracked by Prisma)
  owner         String?            // owner
  email         String?            // owner email
  address       String?            // street
  building      String?            // building number
  number        String             // apartment number (can be "3A")
  postalCode    String?
  city          String?
  shareNumerator        Float?             // numerator of ownership share
  shareDenominator      Float?             // denominator of ownership share
  // numerator / denominator, GENERATED ALWAYS in the migration; never write it.
  // The expression is the exact text `prisma db pull` reports.
  shareRatio            Float?             @default(dbgenerated("\nCASE\n    WHEN (\"shareDenominator\" > (0)::double precision) THEN (\"shareNumerator\" / \"shareDenominator\")\n    ELSE NULL::double precision\nEND"))
  
  // Owner period from lok.txt; validTo is null for the current owner
  validFrom   DateTime?
  validTo     DateTime?

  // Activity status
  isActive    Boolean  @default(true)  // whether apartment is in current file
  
  // Homeowners' Association relation
  homeownersAssociation   HomeownersAssociation @relation(fields: [homeownersAssociationId], references: [id])
  homeownersAssociationId String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationship with user (many-to-one: each apartment belongs to one user)
  user        User?   @relation(fields: [userId], references: [id])
  userId      String?
  
  // Charges for this apartment
  charges               Charge[]
  chargeNotifications   ChargeNotification[]
  payments              Payment[]
  
  @@unique([externalOwnerId, externalApartmentId])
  @@index([externalOwnerId])
  @@index([externalApartmentId])
  @@index([isActive])
  @@index([homeownersAssociationId])
  @@index([userId])
}

model Charge {
  id              String   @id @default(cuid())
  externalLineNo  Int      // line number from file
  
  // Apartment relation
  apartment       Apartment @relation(fields: [apartmentId], references: [id])
  apartmentId     String
  
  // Dates and period
  dateFrom        DateTime
  dateTo          DateTime
  period          String   // e.g. "202501"
  
  // Charge details
  description     String
  quantity        Decimal  @db.Decimal(14, 4)
  unit            String   // e.g. "szt", "m2"
  unitPrice       Decimal  @db.Decimal(14, 4)
  totalAmount     Decimal  @db.Decimal(14, 4)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([apartmentId, period, externalLineNo])
  @@index([apartmentId])
  @@index([period])
  @@index([dateFrom])
}

model ChargeNotification {
  id              String   @id @default(cuid())
  lineNo          Int      // position in file
  
  // Apartment relation
  apartment       Apartment @relation(fields: [apartmentId], references: [id])
  apartmentId     String
  
  // Charge details
  description     String
  quantity        Decimal  @db.Decimal(14, 4)
  unit            String   // e.g. "szt.", "m2"
  unitPrice       Decimal  @db.Decimal(14, 4)
  totalAmount     Decimal  @db.Decimal(14, 4)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([apartmentId, lineNo])
  @@index([apartmentId])
}

model Payment {
  id              String   @id @default(cuid())
  
  // Apartment relation
  apartment       Apartment @relation(fields: [apartmentId], references: [id])
  apartmentId     String
  
  // Period information
  year            Int
  dateFrom        DateTime
  dateTo          DateTime
  
  // Balances
  openingBalance  Decimal  @db.Decimal(14, 4)
  // Loaded from wplaty.txt and built on the incorrect monthly charges below, so
  // it is never presented. The closing balance is derived from Charge records.
  legacyClosingBalance Decimal @db.Decimal(14, 4) @map("closingBalance")

  // Opening period breakdown (from wplaty.txt fields 6 and 7)
  openingDebt    Decimal  @default(0) @db.Decimal(14, 4)
  openingSurplus Decimal  @default(0) @db.Decimal(14, 4)

  // Monthly payments (12 months)
  januaryPayments         Decimal  @default(0) @db.Decimal(14, 4)
  februaryPayments        Decimal  @default(0) @db.Decimal(14, 4)
  marchPayments           Decimal  @default(0) @db.Decimal(14, 4)
  aprilPayments           Decimal  @default(0) @db.Decimal(14, 4)
  mayPayments             Decimal  @default(0) @db.Decimal(14, 4)
  junePayments            Decimal  @default(0) @db.Decimal(14, 4)
  julyPayments            Decimal  @default(0) @db.Decimal(14, 4)
  augustPayments          Decimal  @default(0) @db.Decimal(14, 4)
  septemberPayments       Decimal  @default(0) @db.Decimal(14, 4)
  octoberPayments         Decimal  @default(0) @db.Decimal(14, 4)
  novemberPayments        Decimal  @default(0) @db.Decimal(14, 4)
  decemberPayments        Decimal  @default(0) @db.Decimal(14, 4)

  // Monthly charges (12 months) loaded from wplaty.txt. The exporter omits
  // settlement lines, so these values are incorrect and are never presented.
  // Charges are calculated from Charge records instead.
  legacyJanuaryCharges Decimal @default(0) @db.Decimal(14, 4) @map("januaryCharges")
  legacyFebruaryCharges Decimal @default(0) @db.Decimal(14, 4) @map("februaryCharges")
  legacyMarchCharges Decimal @default(0) @db.Decimal(14, 4) @map("marchCharges")
  legacyAprilCharges Decimal @default(0) @db.Decimal(14, 4) @map("aprilCharges")
  legacyMayCharges Decimal @default(0) @db.Decimal(14, 4) @map("mayCharges")
  legacyJuneCharges Decimal @default(0) @db.Decimal(14, 4) @map("juneCharges")
  legacyJulyCharges Decimal @default(0) @db.Decimal(14, 4) @map("julyCharges")
  legacyAugustCharges Decimal @default(0) @db.Decimal(14, 4) @map("augustCharges")
  legacySeptemberCharges Decimal @default(0) @db.Decimal(14, 4) @map("septemberCharges")
  legacyOctoberCharges Decimal @default(0) @db.Decimal(14, 4) @map("octoberCharges")
  legacyNovemberCharges Decimal @default(0) @db.Decimal(14, 4) @map("novemberCharges")
  legacyDecemberCharges Decimal @default(0) @db.Decimal(14, 4) @map("decemberCharges")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([apartmentId, year])
  @@index([apartmentId])
  @@index([year])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  expiresAt DateTime
  verified  Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([code])
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
