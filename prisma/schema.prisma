// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  CREDENTIALS
  GOOGLE
}

enum UserRole {
  ADMIN
  TENANT
}

enum AccountStatus {
  PENDING    // Waiting for approval
  APPROVED   // Approved by admin
  REJECTED   // Rejected
}

model HomeownersAssociation {
  id          String   @id @default(cuid())
  externalId  String   @unique  // ID from folder structure
  name        String              // defaults to externalId, can be changed by admin

  // Parsed from pow_czynsz.txt on notification import
  header      String?
  footer      String?

  // Data-as-of dates from .wmb files, updated on each import
  apartmentsDataDate     DateTime?
  chargesDataDate        DateTime?
  notificationsDataDate  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  apartments  Apartment[]
  votings     Voting[]
  
  @@index([externalId])
}

model User {
  id             String   @id @default(cuid())
  // Stored normalised (trimmed, lowercased) — see src/lib/auth/rules/email.ts.
  // CHECK (email = lower(btrim(email))): "User_email_normalized_check", set in migration, not tracked by Prisma
  email          String   @unique
  password       String?
  // COLLATE "pl_numeric" (set in migration, not tracked by Prisma)
  name           String?
  role           UserRole @default(TENANT)
  status         AccountStatus @default(PENDING)
  emailVerified       Boolean  @default(false)
  mustChangePassword  Boolean  @default(false)
  authMethod          AuthMethod? @default(CREDENTIALS)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationship with apartments (one-to-many: one user can own multiple apartments)
  apartments         Apartment[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  votingBallots      VotingBallot[]
  votingConfirmations VotingConfirmation[]
  
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([emailVerified])
}

model Apartment {
  id                  String   @id @default(cuid())
  externalOwnerId     String       // Owner ID from file (e.g. "W00164")
  externalApartmentId String       // Apartment ID from HOA system (e.g. "KLO11-KLO11-00000-00004M")
  // owner, address, building, number: COLLATE "pl_numeric" (set in migration, not tracked by Prisma)
  owner         String?            // owner
  email         String?            // owner email
  address       String?            // street
  building      String?            // building number
  number        String             // apartment number (can be "3A")
  postalCode    String?
  city          String?
  shareNumerator        Float?             // numerator of ownership share
  shareDenominator      Float?             // denominator of ownership share
  // numerator / denominator, GENERATED ALWAYS in the migration; never write it.
  // The expression is the exact text `prisma db pull` reports.
  shareRatio            Float?             @default(dbgenerated("\nCASE\n    WHEN (\"shareDenominator\" > (0)::double precision) THEN (\"shareNumerator\" / \"shareDenominator\")\n    ELSE NULL::double precision\nEND"))
  
  // Owner period from lok.txt; validTo is null for the current owner
  validFrom   DateTime?
  validTo     DateTime?

  // Activity status
  isActive    Boolean  @default(true)  // whether apartment is in current file
  
  // Homeowners' Association relation
  homeownersAssociation   HomeownersAssociation @relation(fields: [homeownersAssociationId], references: [id])
  homeownersAssociationId String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationship with user (many-to-one: each apartment belongs to one user)
  user        User?   @relation(fields: [userId], references: [id])
  userId      String?
  
  // Charges for this apartment
  charges               Charge[]
  chargeNotifications   ChargeNotification[]
  payments              Payment[]
  utilitySettlements    UtilitySettlement[]
  annualCostSettlements AnnualCostSettlement[]
  votingBallots         VotingBallot[]
  
  @@unique([externalOwnerId, externalApartmentId])
  @@index([externalOwnerId])
  @@index([externalApartmentId])
  @@index([isActive])
  @@index([homeownersAssociationId])
  @@index([userId])
}

model Charge {
  id              String   @id @default(cuid())
  externalLineNo  Int      // line number from file
  
  // Apartment relation
  apartment       Apartment @relation(fields: [apartmentId], references: [id])
  apartmentId     String
  
  // Dates and period
  dateFrom        DateTime
  dateTo          DateTime
  period          String   // e.g. "202501"
  
  // Charge details
  description     String
  quantity        Decimal  @db.Decimal(14, 4)
  unit            String   // e.g. "szt", "m2"
  unitPrice       Decimal  @db.Decimal(14, 4)
  totalAmount     Decimal  @db.Decimal(14, 4)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([apartmentId, period, externalLineNo])
  @@index([apartmentId])
  @@index([period])
  @@index([dateFrom])
  @@index([updatedAt])
}

model ChargeNotification {
  id              String   @id @default(cuid())
  lineNo          Int      // position in file
  
  // Apartment relation
  apartment       Apartment @relation(fields: [apartmentId], references: [id])
  apartmentId     String
  
  // Charge details
  description     String
  quantity        Decimal  @db.Decimal(14, 4)
  unit            String   // e.g. "szt.", "m2"
  unitPrice       Decimal  @db.Decimal(14, 4)
  totalAmount     Decimal  @db.Decimal(14, 4)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([apartmentId, lineNo])
  @@index([apartmentId])
}

model Payment {
  id              String   @id @default(cuid())
  
  // Apartment relation
  apartment       Apartment @relation(fields: [apartmentId], references: [id])
  apartmentId     String
  
  // Period information
  year            Int
  dateFrom        DateTime
  dateTo          DateTime
  
  // Balances
  openingBalance  Decimal  @db.Decimal(14, 4)
  // Loaded from wplaty.txt and built on the incorrect monthly charges below, so
  // it is never presented. The closing balance is derived from Charge records.
  legacyClosingBalance Decimal @db.Decimal(14, 4) @map("closingBalance")

  // Opening period breakdown (from wplaty.txt fields 6 and 7)
  openingDebt    Decimal  @default(0) @db.Decimal(14, 4)
  openingSurplus Decimal  @default(0) @db.Decimal(14, 4)

  // Monthly payments (12 months)
  januaryPayments         Decimal  @default(0) @db.Decimal(14, 4)
  februaryPayments        Decimal  @default(0) @db.Decimal(14, 4)
  marchPayments           Decimal  @default(0) @db.Decimal(14, 4)
  aprilPayments           Decimal  @default(0) @db.Decimal(14, 4)
  mayPayments             Decimal  @default(0) @db.Decimal(14, 4)
  junePayments            Decimal  @default(0) @db.Decimal(14, 4)
  julyPayments            Decimal  @default(0) @db.Decimal(14, 4)
  augustPayments          Decimal  @default(0) @db.Decimal(14, 4)
  septemberPayments       Decimal  @default(0) @db.Decimal(14, 4)
  octoberPayments         Decimal  @default(0) @db.Decimal(14, 4)
  novemberPayments        Decimal  @default(0) @db.Decimal(14, 4)
  decemberPayments        Decimal  @default(0) @db.Decimal(14, 4)

  // Monthly charges (12 months) loaded from wplaty.txt. The exporter omits
  // settlement lines, so these values are incorrect and are never presented.
  // Charges are calculated from Charge records instead.
  legacyJanuaryCharges Decimal @default(0) @db.Decimal(14, 4) @map("januaryCharges")
  legacyFebruaryCharges Decimal @default(0) @db.Decimal(14, 4) @map("februaryCharges")
  legacyMarchCharges Decimal @default(0) @db.Decimal(14, 4) @map("marchCharges")
  legacyAprilCharges Decimal @default(0) @db.Decimal(14, 4) @map("aprilCharges")
  legacyMayCharges Decimal @default(0) @db.Decimal(14, 4) @map("mayCharges")
  legacyJuneCharges Decimal @default(0) @db.Decimal(14, 4) @map("juneCharges")
  legacyJulyCharges Decimal @default(0) @db.Decimal(14, 4) @map("julyCharges")
  legacyAugustCharges Decimal @default(0) @db.Decimal(14, 4) @map("augustCharges")
  legacySeptemberCharges Decimal @default(0) @db.Decimal(14, 4) @map("septemberCharges")
  legacyOctoberCharges Decimal @default(0) @db.Decimal(14, 4) @map("octoberCharges")
  legacyNovemberCharges Decimal @default(0) @db.Decimal(14, 4) @map("novemberCharges")
  legacyDecemberCharges Decimal @default(0) @db.Decimal(14, 4) @map("decemberCharges")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([apartmentId, year])
  @@index([apartmentId])
  @@index([year])
}

enum UtilitySettlementLineKind {
  ADVANCE     // column "Zaliczka"
  CONSUMPTION // column "Do zapłaty": the quantity is the consumption
}

// Imported from the utility settlement printout; values are stored as printed
model UtilitySettlement {
  id             String   @id @default(cuid())

  apartment      Apartment @relation(fields: [apartmentId], references: [id])
  apartmentId    String

  periodFrom     DateTime
  periodTo       DateTime
  issuedOn       DateTime
  printedOwner   String
  sourceFileName String
  totalAmount    Decimal  @db.Decimal(14, 4) // positive = to pay, negative = overpaid

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  summaries UtilitySettlementSummary[]
  lines     UtilitySettlementLine[]
  readings  MeterReading[]

  @@unique([apartmentId, periodFrom, periodTo])
}

// One row of the summary block
model UtilitySettlementSummary {
  id              String  @id @default(cuid())
  lineNo          Int

  settlement      UtilitySettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  settlementId    String

  code            String // row label as printed, e.g. "CW"
  consumption     Decimal @db.Decimal(14, 6)
  advanceQuantity Decimal @db.Decimal(14, 6)
  difference      Decimal @db.Decimal(14, 6)
  amount          Decimal @db.Decimal(14, 4)

  @@unique([settlementId, lineNo])
}

model UtilitySettlementLine {
  id           String @id @default(cuid())
  lineNo       Int

  settlement   UtilitySettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  settlementId String

  kind         UtilitySettlementLineKind
  description  String
  dateFrom     DateTime
  dateTo       DateTime
  quantity     Decimal  @db.Decimal(14, 6)
  unitPrice    Decimal  @db.Decimal(14, 4)
  amount       Decimal  @db.Decimal(14, 4)

  @@unique([settlementId, lineNo])
}

model MeterReading {
  id           String @id @default(cuid())
  lineNo       Int

  settlement   UtilitySettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  settlementId String

  device       String // e.g. "CO 01"
  serialNumber String
  label        String // e.g. "CO mieszkania"
  unit         String
  startDate    DateTime
  startValue   Decimal  @db.Decimal(14, 3)
  endDate      DateTime
  endValue     Decimal  @db.Decimal(14, 3)
  consumption  Decimal  @db.Decimal(14, 3)

  @@unique([settlementId, lineNo])
  @@index([serialNumber])
}

// Imported from the annual cost settlement printout
model AnnualCostSettlement {
  id             String   @id @default(cuid())

  apartment      Apartment @relation(fields: [apartmentId], references: [id])
  apartmentId    String

  periodFrom     DateTime
  periodTo       DateTime
  issuedOn       DateTime
  printedOwner   String
  sourceFileName String
  totalAmount    Decimal  @db.Decimal(14, 4) // positive = to pay, negative = overpaid

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items AnnualCostSettlementItem[]

  @@unique([apartmentId, periodFrom, periodTo])
}

model AnnualCostSettlementItem {
  id               String @id @default(cuid())
  lineNo           Int

  settlement       AnnualCostSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  settlementId     String

  title            String
  basisDescription String // "Współczynnik ustalony wg"
  periodFrom       DateTime
  periodTo         DateTime
  communityAmount  Decimal  @db.Decimal(14, 4)
  flatBasis        Decimal  @db.Decimal(14, 4)
  communityBasis   Decimal  @db.Decimal(14, 4)
  coefficient      Decimal  @db.Decimal(7, 4)
  amount           Decimal  @db.Decimal(14, 4) // positive = to pay, negative = overpaid

  @@unique([settlementId, lineNo])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  expiresAt DateTime
  verified  Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([code])
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

enum VotingStatus {
  DRAFT // Wersja robocza: invisible to tenants, editable
  ACTIVE // Aktywne: tenants vote
  CLOSED // Zakończone: no more votes; only admins see the results
  ARCHIVED // Zarchiwizowane: hidden from tenants
}

enum VoteChoice {
  FOR // Za
  AGAINST // Przeciw
  ABSTAIN // Wstrzymał(a) się
}

model Voting {
  id           String                @id @default(cuid())
  hoaId        String
  hoa          HomeownersAssociation @relation(fields: [hoaId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       VotingStatus          @default(DRAFT)
  endsAt       DateTime? // optional deadline: no ballot is accepted after it
  allowAbstain Boolean               @default(true) // whether ABSTAIN is an accepted answer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions     VotingQuestion[]
  ballots       VotingBallot[]
  confirmations VotingConfirmation[]

  @@index([hoaId])
  @@index([status])
}

model VotingQuestion {
  id       String @id @default(cuid())
  votingId String
  voting   Voting @relation(fields: [votingId], references: [id], onDelete: Cascade)
  position Int
  text     String

  votes VotingVote[]

  @@unique([votingId, position])
}

// One apartment's vote. The unique key is the guard against voting twice.
model VotingBallot {
  id          String    @id @default(cuid())
  votingId    String
  voting      Voting    @relation(fields: [votingId], references: [id], onDelete: Cascade)
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  userId      String? // null: cast at a meeting and entered by an admin
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  votes VotingVote[]

  @@unique([votingId, apartmentId])
  @@index([userId])
}

model VotingVote {
  id         String         @id @default(cuid())
  ballotId   String
  ballot     VotingBallot   @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  questionId String
  question   VotingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choice     VoteChoice

  @@unique([ballotId, questionId])
  @@index([questionId, choice])
}

// A submitted ballot waiting for its emailed confirmation link; deleted when used.
model VotingConfirmation {
  id        String   @id @default(cuid())
  votingId  String
  voting    Voting   @relation(fields: [votingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // SHA-256 of the random token in the emailed link
  answers   Json // { [apartmentId]: { [questionId]: VoteChoice } }
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([votingId, userId])
  @@index([expiresAt])
}

// Singleton: exactly one row (id = 1).
// CHECK constraints are set in migrations, not tracked by Prisma.
model AppSettings {
  // CHECK (id = 1): "AppSettings_singleton"
  id                     Int      @id @default(1)
  // CHECK (tenantHistoryYearsBack BETWEEN 0 AND 20): "AppSettings_tenantHistoryYearsBack_range"
  tenantHistoryYearsBack Int      @default(2)
  // CHECK (char_length(privacyPolicy) <= 50000): "AppSettings_privacyPolicy_length"
  privacyPolicy          String?
  updatedAt              DateTime @updatedAt
}

// One row per claimed scheduled run, keyed "<job name>:<scheduled time ISO>".
// The primary key makes claiming atomic: only one insert of a key succeeds.
model CronRun {
  key       String   @id
  claimedAt DateTime @default(now())

  @@index([claimedAt])
}
